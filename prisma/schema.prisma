generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Booking {
  id          String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  showId      String     @map("show_id") @db.Uuid
  // Placeholder until auth: becomes customer_email in the W5 migration drill, then a user_id FK in M3/M4.
  customerRef String     @map("customer_ref")
  status      String     @default("pending")
  // Price snapshot taken at reservation; a later show price change doesn't touch it.
  totalMinor  Int        @map("total_minor")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  // Not @updatedAt: booking writes use raw SQL, so every UPDATE sets updated_at = now() itself.
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Bookings are never deleted, only cancelled or expired, so a show with bookings can't be deleted.
  show        Show       @relation(fields: [showId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  showSeats   ShowSeat[]

  // CHECKs in migration booking_core: status IN ('pending', 'confirmed', 'cancelled', 'expired'), total_minor >= 0.
  @@map("bookings")
}

model EventCategory {
  code   String  @id
  label  String
  events Event[]

  @@map("event_categories")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Event {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title         String
  description   String
  category      String
  durationMins  Int           @map("duration_mins")
  language      String
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  eventCategory EventCategory @relation(fields: [category], references: [code], onUpdate: NoAction)
  shows         Show[]

  @@map("events")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Screen {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  venueId   String   @map("venue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  venue     Venue    @relation(fields: [venueId], references: [id], onUpdate: NoAction)
  seats     Seat[]
  shows     Show[]

  // Case-insensitive unique (venue_id, lower(name)) lives in migration 20261119141117; Prisma can't express it.
  @@map("screens")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model SeatCategory {
  code      String @id
  label     String
  sortOrder Int    @unique @map("sort_order")
  seats     Seat[]

  @@map("seat_categories")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Seat {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  screenId     String       @map("screen_id") @db.Uuid
  rowLabel     String       @map("row_label")
  seatNumber   Int          @map("seat_number")
  category     String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  seatCategory SeatCategory @relation(fields: [category], references: [code], onUpdate: NoAction)
  screen       Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  showSeats    ShowSeat[]

  @@unique([screenId, rowLabel, seatNumber])
  @@map("seats")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Show {
  id         String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId    String     @map("event_id") @db.Uuid
  screenId   String     @map("screen_id") @db.Uuid
  startsAt   DateTime   @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime   @map("ends_at") @db.Timestamptz(6)
  priceMinor Int        @map("price_minor")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  event      Event      @relation(fields: [eventId], references: [id], onUpdate: NoAction)
  screen     Screen     @relation(fields: [screenId], references: [id], onUpdate: NoAction)
  bookings   Booking[]
  showSeats  ShowSeat[]

  @@unique([screenId, startsAt])
  @@map("shows")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// One row per seat per show: the row a booking locks or version-checks.
model ShowSeat {
  showId    String    @map("show_id") @db.Uuid
  seatId    String    @map("seat_id") @db.Uuid
  status    String    @default("available")
  bookingId String?   @map("booking_id") @db.Uuid
  // Set from the database clock: now() + BOOKING_HOLD_MINUTES.
  heldUntil DateTime? @map("held_until") @db.Timestamptz(6)
  version   Int       @default(0)
  // Not @updatedAt: booking writes use raw SQL, so every UPDATE sets updated_at = now() itself.
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Seat inventory belongs to the show; an unbooked show takes its rows with it.
  show      Show      @relation(fields: [showId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // A seat that belongs to a scheduled show can't be deleted.
  seat      Seat      @relation(fields: [seatId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // CHECKs in migration booking_core: status IN ('available', 'reserved', 'booked'), version >= 0, and
  // show_seats_state_check tying each status to booking_id and held_until.
  @@id([showId, seatId])
  @@map("show_seats")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Venue {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  city      String
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  screens   Screen[]

  @@unique([name, city])
  @@map("venues")
}
