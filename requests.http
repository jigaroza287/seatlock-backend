@baseUrl = http://localhost:8000/api

### Create event (201)
# @name createEvent
POST {{baseUrl}}/events
Content-Type: application/json

{ "title": "Test Title", "description": "This is a short description", "category": "concert", "durationMins": 240, "language": "en" }

### Get the event just created (200)
GET {{baseUrl}}/events/{{createEvent.response.body.$.data.id}}

### Get all the events (200)
GET {{baseUrl}}/events

### Create another event (201)
POST {{baseUrl}}/events
Content-Type: application/json

{ "title": "Test Title 1", "description": "This is a short description", "category": "concert", "durationMins": 240, "language": "en" }

### Event title already exists while updating event title (409)
PATCH {{baseUrl}}/events/{{createEvent.response.body.$.data.id}}
Content-Type: application/json

{ "title": "Test Title 1" }

### Invalid body (400)
POST {{baseUrl}}/events
Content-Type: application/json

{ "title": 123 }

### Unknown id (404)
GET {{baseUrl}}/events/00000000-0000-0000-0000-000000000000

### Delete event (204)
DELETE {{baseUrl}}/events/{{createEvent.response.body.$.data.id}}

### Duplicate title on create (409), run after "Create event"
POST {{baseUrl}}/events
Content-Type: application/json

{ "title": "Test Title", "description": "Another long enough description", "category": "comedy", "durationMins": 90, "language": "en" }

### Update title (200)
PATCH {{baseUrl}}/events/{{createEvent.response.body.$.data.id}}
Content-Type: application/json

{ "title": "Renamed Title" }

### Verify the update was saved (200, title must be "Renamed Title")
GET {{baseUrl}}/events/{{createEvent.response.body.$.data.id}}

### Empty PATCH (400)
PATCH {{baseUrl}}/events/{{createEvent.response.body.$.data.id}}
Content-Type: application/json

{}

### Read-only id in PATCH (400, strict schema)
PATCH {{baseUrl}}/events/{{createEvent.response.body.$.data.id}}
Content-Type: application/json

{ "id": "abc" }

### Bad UUID (400)
GET {{baseUrl}}/events/not-a-uuid

### Malformed JSON (400)
POST {{baseUrl}}/events
Content-Type: application/json

{ "title": 

### Bad pagination (400)
GET {{baseUrl}}/events?limit=abc

### Pagination works (200, check the pagination object)
GET {{baseUrl}}/events?limit=1&offset=0

### Verify the delete worked (404), run after "Delete event"
GET {{baseUrl}}/events/{{createEvent.response.body.$.data.id}}

### Create venue (201)
# @name createVenue
POST {{baseUrl}}/venues
Content-Type: application/json

{ "name": "Main hall", "city": "Pune", "address": "12 Station Road" }

### Get the venue just created (200)
GET {{baseUrl}}/venues/{{createVenue.response.body.$.data.id}}

### Create venue without address (201, address is null)
POST {{baseUrl}}/venues
Content-Type: application/json

{ "name": "Main hall", "city": "Mumbai" }

### List venues (200, sorted by name then city)
GET {{baseUrl}}/venues

### Filter by search and city (200, city is a case-insensitive exact match)
GET {{baseUrl}}/venues?search=hall&city=pune

### Same name in the same city (409), run after "Create venue"
POST {{baseUrl}}/venues
Content-Type: application/json

{ "name": "Main hall", "city": "Pune" }

### Null address on create (400, POST can only omit it)
POST {{baseUrl}}/venues
Content-Type: application/json

{ "name": "Side hall", "city": "Pune", "address": null }

### Clear the address (200, address must be null)
PATCH {{baseUrl}}/venues/{{createVenue.response.body.$.data.id}}
Content-Type: application/json

{ "address": null }

### Rename onto an existing name in the same city (409), run after "Create venue without address"
PATCH {{baseUrl}}/venues/{{createVenue.response.body.$.data.id}}
Content-Type: application/json

{ "city": "Mumbai" }

### Read-only id in PATCH (400, strict schema)
PATCH {{baseUrl}}/venues/{{createVenue.response.body.$.data.id}}
Content-Type: application/json

{ "id": "abc" }

### Unknown venue id (404)
GET {{baseUrl}}/venues/019a0000-0000-7000-8000-000000000999

### Delete venue (204)
DELETE {{baseUrl}}/venues/{{createVenue.response.body.$.data.id}}

### Create screen (201, Location is /api/screens/:id), run after "Create venue"
# @name createScreen
POST {{baseUrl}}/venues/{{createVenue.response.body.$.data.id}}/screens
Content-Type: application/json

{ "name": "Screen 1" }

### Get the screen just created (200)
GET {{baseUrl}}/screens/{{createScreen.response.body.$.data.id}}

### List the venue's screens (200, sorted by name)
GET {{baseUrl}}/venues/{{createVenue.response.body.$.data.id}}/screens

### Same name at the same venue (409), run after "Create screen"
POST {{baseUrl}}/venues/{{createVenue.response.body.$.data.id}}/screens
Content-Type: application/json

{ "name": "Screen 1" }

### venueId in the body (400, it comes from the path)
POST {{baseUrl}}/venues/{{createVenue.response.body.$.data.id}}/screens
Content-Type: application/json

{ "name": "Screen 2", "venueId": "{{createVenue.response.body.$.data.id}}" }

### Create screen at an unknown venue (404, VENUE_NOT_FOUND)
POST {{baseUrl}}/venues/019a0000-0000-7000-8000-000000000999/screens
Content-Type: application/json

{ "name": "Screen 1" }

### List screens of an unknown venue (404, VENUE_NOT_FOUND)
GET {{baseUrl}}/venues/019a0000-0000-7000-8000-000000000999/screens

### Bad venue id (400)
GET {{baseUrl}}/venues/not-a-uuid/screens

### Rename screen (200)
PATCH {{baseUrl}}/screens/{{createScreen.response.body.$.data.id}}
Content-Type: application/json

{ "name": "Screen 2" }

### Empty PATCH (400)
PATCH {{baseUrl}}/screens/{{createScreen.response.body.$.data.id}}
Content-Type: application/json

{}

### Unknown screen id (404)
GET {{baseUrl}}/screens/019a0000-0000-7000-8000-000000000999

### Delete venue that has a screen (409), run before "Delete screen"
DELETE {{baseUrl}}/venues/{{createVenue.response.body.$.data.id}}

### Delete screen (204)
DELETE {{baseUrl}}/screens/{{createScreen.response.body.$.data.id}}
